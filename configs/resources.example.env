# SkillHandoffBench 资源变量模板（只放变量名/示例值，不含任何凭据）
# 用法：复制为 configs/resources.local.env（该文件已被 .gitignore 排除），填入真实值后 source。
# 下面所有默认值都是 2026-11-06 在服务器 222.29.51.96 上**实测存在**的路径。

# ---- 服务器连接（凭据只放在 resources.local.env）----
export SHB_SSH_HOST="222.29.51.96"
export SHB_SSH_PORT="22"
export SHB_SSH_USER="lijh"
# export SHB_SSH_PASSWORD="<向用户索取，勿提交>"

# ---- 服务器根路径 ----
export SHB_SERVER_ROOT="/scratch/lijh"
export SHB_WORKSPACE="/scratch/lijh/SkillHandoffBench"
export SHB_THIRD_PARTY="${SHB_WORKSPACE}/third_party"
export SHB_ROBOCOMBINE="${SHB_THIRD_PARTY}/RoboCombine"
export SHB_MOTUS_SRC="${SHB_THIRD_PARTY}/Motus-src"
export SHB_RESULTS="${SHB_WORKSPACE}/results"

# ---- 现有环境（复用，不要覆盖）----
export SHB_PYBULLET_VENV="/scratch/lijh/simulate_vla/venv"
export SHB_OPENPI_VENV="/scratch/lijh/exp40/openpi/.venv"
export SHB_OPENPI_SRC="/scratch/lijh/exp40/openpi"

# ---- 旧项目（只读，勿修改）----
export SHB_SIMULATE_SRC="/scratch/lijh/exp40/repo"
export SHB_SIMULATE_DATA="/scratch/lijh/exp43/export_v3"
export SHB_SIMULATE_LORA_B12000="/scratch/lijh/exp44/B/ckpts/lora_step12000.npz"

# ---- RoboCombine（2026-11-06 实测）----
export SHB_ROBOCOMBINE_COMMIT="df237b22bd5c39d705b103daf2b9a8a168c9d453"
export SHB_ROBOCOMBINE_ASSETS="${SHB_ROBOCOMBINE}/assets"

# ---- 新建的隔离运行环境（不覆盖任何旧环境）----
export SHB_MOTUS_VENV="${SHB_WORKSPACE}/envs/motus"
export SHB_MOTUS_PY="${SHB_MOTUS_VENV}/bin/python"

# ---- 模型 / 权重 ----
export SHB_MODELS="${SHB_WORKSPACE}/assets/models"
export SHB_MOTUS_CKPT="${SHB_MODELS}/Motus_robotwin2"          # 内含 mp_rank_00_model_states.pt (16.05 GB)
export SHB_MOTUS_WAN_DIR="${SHB_MODELS}/Wan2.2-TI2V-5B"        # 只需 T5 + VAE + umt5 tokenizer
export SHB_MOTUS_VLM_DIR="${SHB_MODELS}/Qwen3-VL-2B-Instruct"

# ---- Vulkan loader（系统缺 libvulkan.so.1，复用 conda 缓存，不安装系统包）----
export SHB_VK_LIB_DIR="/scratch/lijh/.conda/pkgs/libvulkan-loader-1.4.341.0-h5279c79_0/lib"
export VK_ICD_FILENAMES="/etc/vulkan/icd.d/nvidia_icd.json"

# ---- pi05（本轮不使用：手上的 pi05_droid 与 pi05_aloha_full_base 不兼容）----
# export SHB_PI05_CKPT="<pi05_aloha_full_base checkpoint root，内含 assets/<id>>"

# ---- 运行控制 ----
export SHB_GPU="0"                 # 单卡；不得并行多卡
export SHB_SMOKE_MAX_MINUTES="30"  # 单次 smoke 的 wall-clock 上限
export SHB_CLEAR_CACHE="false"     # 论文设置：保留当前 action chunk
