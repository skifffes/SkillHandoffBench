export SHB_SSH_USER="lijh"
# export SHB_SSH_PASSWORD="<向用户索取，勿提交>"

# ---- 服务器根路径 ----
export SHB_SERVER_ROOT="/scratch/lijh"
export SHB_WORKSPACE="/scratch/lijh/SkillHandoffBench"
export SHB_THIRD_PARTY="${SHB_WORKSPACE}/third_party"
